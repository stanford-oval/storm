# STORM API Keys Template
# Copy to secrets.toml and fill in your keys
# NEVER commit secrets.toml to version control!

# ==========================================
# LLM Provider Keys (at least one required)
# ==========================================

# OpenAI (GPT-3.5, GPT-4, GPT-4o, embeddings)
OPENAI_API_KEY = "sk-..."
# Azure OpenAI (alternative to OpenAI)
# AZURE_API_KEY = "..."
# AZURE_API_BASE = "https://your-resource.openai.azure.com/"
# AZURE_API_VERSION = "2024-02-01"

# Anthropic (Claude)
# ANTHROPIC_API_KEY = "sk-ant-..."

# ==========================================
# Search Engine Keys (at least one required)
# ==========================================

# You.com (YouRM)
YDC_API_KEY = "..."

# Bing Search (BingSearch)
BING_SEARCH_API_KEY = "..."

# Brave Search (BraveRM)
BRAVE_API_KEY = "..."

# Serper / Google Search (SerperRM)
SERPER_API_KEY = "..."

# Tavily (TavilySearchRM)
TAVILY_API_KEY = "..."

# SearXNG (SearXNG)
SEARXNG_API_KEY = "..."

# Azure AI Search (AzureAISearch)
# AZURE_AI_SEARCH_API_KEY = "..."
# AZURE_AI_SEARCH_URL = "https://your-search.search.windows.net"
# AZURE_AI_SEARCH_INDEX_NAME = "your-index"

# ==========================================
# Local / Self-Hosted Model Config
# ==========================================

# Ollama
OLLAMA_BASE_URL = "http://localhost:11434"
OLLAMA_FAST_MODEL = "llama3.1:8b"
OLLAMA_SMART_MODEL = "llama3.1:70b"

# vLLM
# VLLM_URL = "http://localhost:8000/v1"

# TGI
# TGI_URL = "http://localhost:8080"

# Together.ai
# TOGETHER_API_KEY = "..."

# ==========================================
# VectorRM (Qdrant) Config
# ==========================================

# Qdrant Cloud
# QDRANT_API_KEY = "..."
# QDRANT_URL = "https://your-cluster.qdrant.io"

# Local Qdrant (no key needed)
# QDRANT_PATH = "./vector_db"